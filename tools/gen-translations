#!/usr/bin/env python3
"""Compile local JSON catalogs; --check verifies generated source and coverage."""
import json, pathlib, re, sys
root = pathlib.Path(__file__).resolve().parent.parent
codes = 'de fr es it pt nl pl'.split()
keys = set()
for path in (root / 'src').rglob('*.rs'):
    if path.name == 'translations_generated.rs':
        continue
    keys.update(json.loads(m) for m in re.findall(r'\btrf?\(\s*("(?:[^"\\]|\\.)*")', path.read_text()))
# Desktop strings also belong to the catalogs.
for path in (root / 'data').glob('*.desktop'):
    keys.update(re.findall(r'^(?:Name|Comment)=(.*)$', path.read_text(), re.M))
out = '// Generated by tools/gen-translations. Do not edit.\n'
out += 'pub fn lookup(language: &str, key: &str) -> Option<&\'static str> {\n    match (language, key) {\n'
for code in codes:
    catalog = {}
    for folder in ['translations', 'translations/extra']:
        catalog.update(json.loads((root / folder / (code + '.json')).read_text()))
    missing = keys - catalog.keys()
    if missing:
        sys.exit(f'{code}: missing translations: {sorted(missing)}')
    for key, value in sorted(catalog.items()):
        assert isinstance(value, str) and value.strip(), (code, key)
        assert set(re.findall(r'\{\d+\}', key)) == set(re.findall(r'\{\d+\}', value)), (code, key)
        out += f'        ({json.dumps(code)}, {json.dumps(key, ensure_ascii=False)}) => Some({json.dumps(value, ensure_ascii=False)}),\n'
out += '        _ => None,\n    }\n}\n'
path = root / 'src/translations_generated.rs'
if '--check' in sys.argv:
    assert path.read_text() == out, 'Run tools/gen-translations'
else:
    path.write_text(out)
print(f'{len(keys)} keys checked in all 7 languages')
